--// CHAOSHUB FULL UI (UPDATED COLOR & HIDE ICON)

local ChaosHub = {}
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")

-- Premium Colors
local MainColor = Color3.fromRGB(20, 20, 20)
local AccentColor = Color3.fromRGB(0, 255, 255) -- Neon Cyan
local SectionColor = Color3.fromRGB(30, 30, 30)
local TextColor = Color3.fromRGB(255, 255, 255)

-- Tween helper
local function Tween(obj, props, time)
    TweenService:Create(obj, TweenInfo.new(time or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- NOTIFICATION
function ChaosHub:Notify(title, text, duration)
    local gui = Instance.new("ScreenGui", game.CoreGui)
    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(0,250,0,80)
    frame.Position = UDim2.new(1,300,1,-90)
    frame.BackgroundColor3 = MainColor
    frame.BorderSizePixel = 0

    local line = Instance.new("Frame", frame)
    line.Size = UDim2.new(0, 4, 1, 0)
    line.BackgroundColor3 = AccentColor
    line.BorderSizePixel = 0

    local titleLabel = Instance.new("TextLabel", frame)
    titleLabel.Size = UDim2.new(1,-10,0,30)
    titleLabel.Position = UDim2.new(0,10,0,0)
    titleLabel.Text = title
    titleLabel.TextColor3 = AccentColor
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.BackgroundTransparency = 1

    local textLabel = Instance.new("TextLabel", frame)
    textLabel.Size = UDim2.new(1,-10,1,-30)
    textLabel.Position = UDim2.new(0,10,0,30)
    textLabel.Text = text
    textLabel.TextColor3 = TextColor
    textLabel.Font = Enum.Font.Gotham
    textLabel.TextWrapped = true
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.BackgroundTransparency = 1

    Tween(frame, {Position = UDim2.new(1,-260,1,-90)}, 0.4)
    task.delay(duration or 3, function()
        Tween(frame, {Position = UDim2.new(1,300,1,-90)}, 0.4)
        task.wait(0.4)
        gui:Destroy()
    end)
end

-- WINDOW
function ChaosHub:CreateWindow(title)
    local gui = Instance.new("ScreenGui", game.CoreGui)
    gui.Name = "ChaosHub_UI"

    -- HIDE/SHOW ICON
    local hideIcon = Instance.new("TextButton", gui)
    hideIcon.Size = UDim2.new(0, 50, 0, 50)
    hideIcon.Position = UDim2.new(0, 10, 0.5, -25)
    hideIcon.BackgroundColor3 = MainColor
    hideIcon.Text = "C" -- Pwedeng palitan ng Icon ID
    hideIcon.TextColor3 = AccentColor
    hideIcon.Font = Enum.Font.GothamBold
    hideIcon.TextSize = 20
    
    local corner = Instance.new("UICorner", hideIcon)
    corner.CornerRadius = UDim.new(1, 0) -- Ginawang bilog
    
    local stroke = Instance.new("UIStroke", hideIcon)
    stroke.Color = AccentColor
    stroke.Thickness = 2

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,500,0,350)
    main.Position = UDim2.new(0.5,-250,0.5,-175)
    main.BackgroundColor3 = MainColor
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    
    local mainCorner = Instance.new("UICorner", main)

    -- Toggle Logic
    hideIcon.MouseButton1Click:Connect(function()
        main.Visible = not main.Visible
        Tween(hideIcon, {Rotation = main.Visible and 0 or 180}, 0.3)
    end)

    -- DRAG LOGIC
    local dragging, dragStart, startPos
    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    -- TITLE BAR
    local titleBar = Instance.new("Frame", main)
    titleBar.Size = UDim2.new(1,0,0,35)
    titleBar.BackgroundColor3 = SectionColor
    titleBar.BorderSizePixel = 0
    
    local titleLabel = Instance.new("TextLabel", titleBar)
    titleLabel.Size = UDim2.new(1,-40,1,0)
    titleLabel.Position = UDim2.new(0,15,0,0)
    titleLabel.Text = title or "ChaosHub v2.0"
    titleLabel.TextColor3 = AccentColor
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.BackgroundTransparency = 1

    -- TAB SYSTEM
    local tabButtons = Instance.new("ScrollingFrame", main)
    tabButtons.Size = UDim2.new(0,130,1,-35)
    tabButtons.Position = UDim2.new(0,0,0,35)
    tabButtons.BackgroundColor3 = SectionColor
    tabButtons.BorderSizePixel = 0
    tabButtons.ScrollBarThickness = 2

    local UIList = Instance.new("UIListLayout", tabButtons)
    UIList.Padding = UDim.new(0, 2)

    local pages = Instance.new("Frame", main)
    pages.Size = UDim2.new(1,-140,1,-45)
    pages.Position = UDim2.new(0,135,0,40)
    pages.BackgroundTransparency = 1

    local Window = {}

    function Window:CreateTab(name)
        local tabBtn = Instance.new("TextButton", tabButtons)
        tabBtn.Size = UDim2.new(1,-5,0,35)
        tabBtn.Text = name
        tabBtn.TextColor3 = TextColor
        tabBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
        tabBtn.Font = Enum.Font.Gotham
        
        local btnCorner = Instance.new("UICorner", tabBtn)

        local page = Instance.new("ScrollingFrame", pages)
        page.Size = UDim2.new(1,0,1,0)
        page.Visible = false
        page.BackgroundTransparency = 1
        page.ScrollBarThickness = 2
        
        local layout = Instance.new("UIListLayout", page)
        layout.Padding = UDim.new(0,8)

        tabBtn.MouseButton1Click:Connect(function()
            for _,v in pairs(pages:GetChildren()) do v.Visible = false end
            for _,v in pairs(tabButtons:GetChildren()) do 
                if v:IsA("TextButton") then Tween(v, {BackgroundColor3 = Color3.fromRGB(40,40,40)}, 0.2) end
            end
            page.Visible = true
            Tween(tabBtn, {BackgroundColor3 = AccentColor}, 0.2)
        end)

        local Tab = {}

        function Tab:Button(text, callback)
            local btn = Instance.new("TextButton", page)
            btn.Size = UDim2.new(1,-10,0,35)
            btn.Text = text
            btn.BackgroundColor3 = Color3.fromRGB(45,45,45)
            btn.TextColor3 = TextColor
            btn.Font = Enum.Font.GothamSemibold
            Instance.new("UICorner", btn)
            
            btn.MouseButton1Click:Connect(function()
                if callback then callback() end
            end)
        end

        function Tab:Toggle(text, callback)
            local state = false
            local btn = Instance.new("TextButton", page)
            btn.Size = UDim2.new(1,-10,0,35)
            btn.Text = text.." [OFF]"
            btn.BackgroundColor3 = Color3.fromRGB(45,45,45)
            btn.TextColor3 = TextColor
            Instance.new("UICorner", btn)

            btn.MouseButton1Click:Connect(function()
                state = not state
                Tween(btn, {TextColor3 = state and AccentColor or TextColor}, 0.2)
                btn.Text = text..(state and " [ON]" or " [OFF]")
                if callback then callback(state) end
            end)
        end

        return Tab
    end
    return Window
end

return ChaosHub
